<!--
    二级菜单的一行:卡片底 + 按压涟漪。
    涟漪用 foreground,不覆盖自身背景(否则圆角与描边会被盖掉)。
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/row_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/row_bg" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/card_stroke" />
        </shape>
    </item>
</ripple>
