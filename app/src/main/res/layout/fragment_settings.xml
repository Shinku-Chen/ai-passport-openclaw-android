<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/page_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 设置二级菜单:一级只列四类入口(卡片行:标题+说明+箭头),点进去才显示该类具体项。
             小智识别默认开启,不再给它任何“选项”,只留状态与一次性激活(见“高级”)。 -->
        <LinearLayout
            android:id="@+id/settingsMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="设置"
                android:textColor="@color/ink"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/btnMenuGateway"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_menu_row"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="网关设置"
                        android:textColor="@color/ink"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="网关类型、域名/端口、Token、模型，以及保存与校验"
                        android:textColor="@color/ink_dim"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="›"
                    android:textColor="@color/accent"
                    android:textSize="22sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnMenuDevice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_menu_row"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="设备管理"
                        android:textColor="@color/ink"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="扫描并连接、断开、忘记设备与重新配对"
                        android:textColor="@color/ink_dim"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="›"
                    android:textColor="@color/accent"
                    android:textSize="22sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnMenuChat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_menu_row"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="对话设置"
                        android:textColor="@color/ink"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="语音附加提示、完整回传流显示、设备朗读（TTS）"
                        android:textColor="@color/ink_dim"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="›"
                    android:textColor="@color/accent"
                    android:textSize="22sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnMenuApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_menu_row"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="应用设置"
                        android:textColor="@color/ink"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="开机自动启动、后台运行许可（自启动 / 无限制）"
                        android:textColor="@color/ink_dim"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="›"
                    android:textColor="@color/accent"
                    android:textSize="22sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnMenuAdvanced"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_menu_row"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="高级"
                        android:textColor="@color/ink"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="小智识别状态与激活、运行日志"
                        android:textColor="@color/ink_dim"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="›"
                    android:textColor="@color/accent"
                    android:textSize="22sp" />
            </LinearLayout>
        </LinearLayout>


            <!-- 返回:描边胶囊,点回一级菜单(系统返回键同效)。 -->
            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:minHeight="0dp"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp"
                android:text="‹ 返回设置"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:visibility="gone"
                app:backgroundTint="@android:color/transparent"
                app:cornerRadius="18dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp" />



        <TextView
            android:id="@+id/titleGateway"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="网关设置"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <!-- 网关类型:决定语音流水线实例化哪个适配器(openclaw / hermes / openai / echo)。
             下拉选择,切换只切可见分组;真正落盘仍要等「保存网关设置」校验通过。 -->
        <TextView
            android:id="@+id/labelGatewayType"
            style="@style/FieldLabel"
            android:text="网关类型" />

        <Spinner
            android:id="@+id/spinnerType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:padding="10dp"
            android:popupBackground="#1A1A2E"
            android:spinnerMode="dropdown" />

        <!-- 明文连接提示:非阻断,只在 host 填了 http:// 或关掉 TLS 时显示。
             明文回放 https/ws 的 token/文本都在链路上裸奔,只建议局域网/自签环境使用。 -->
        <TextView
            android:id="@+id/textCleartextHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#FFB74D"
            android:padding="6dp"
            android:visibility="gone" />

        <!-- OpenClaw:WebSocket + Ed25519 设备鉴权;各套配置各自持久化,切换类型不丢 -->
        <LinearLayout
            android:id="@+id/groupOpenclaw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:padding="12dp"

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OpenClaw(WebSocket)"
                android:textStyle="bold"
                android:textColor="#4FC3F7"
                android:layout_marginTop="8dp" />

            <TextView
                style="@style/FieldLabel"
                android:text="域名" />

            <EditText
                android:id="@+id/inputHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="网关域名或 IP"
                android:inputType="textUri"
                android:autofillHints="url"
                android:textColor="#FFFFFF"
                android:textColorHint="#9E9E9E"
                android:background="@drawable/bg_input"
                android:padding="10dp" />

            <TextView
                style="@style/FieldLabel"
                android:text="端口" />

            <EditText
                android:id="@+id/inputPort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="默认 8035"
                android:inputType="number"
                android:autofillHints="none"
                android:textColor="#FFFFFF"
                android:textColorHint="#9E9E9E"
                android:background="@drawable/bg_input"
                android:padding="10dp" />

            <TextView
                style="@style/FieldLabel"
                android:text="Token" />

            <EditText
                android:id="@+id/inputToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="网关访问令牌(运行时 secret,只存本机)"
                android:inputType="textVisiblePassword"
                android:autofillHints="none"
                android:textColor="#FFFFFF"
                android:textColorHint="#9E9E9E"
                android:background="@drawable/bg_input"
                android:padding="10dp" />

            <TextView
                style="@style/FieldLabel"
                android:text="WS 路径" />

            <EditText
                android:id="@+id/inputWsPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="默认 /message/messages/ws"
                android:inputType="textUri"
                android:autofillHints="none"
                android:textColor="#FFFFFF"
                android:textColorHint="#9E9E9E"
                android:background="@drawable/bg_input"
                android:padding="10dp" />

            <!-- 回复等待上限:Agent 跑工具常要几十秒,默认 180s(越界夹紧到 15..900) -->
            <TextView
                style="@style/FieldLabel"
                android:text="回复等待上限(秒)" />

            <EditText
                android:id="@+id/inputReplyTimeout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="默认 180;Agent 跑工具会很久"
                android:inputType="number"
                android:autofillHints="none"
                android:textColor="#FFFFFF"
                android:textColorHint="#9E9E9E"
                android:background="@drawable/bg_input"
                android:padding="10dp" />

            <!-- 会话名:sessionKey = agent:main:<名字>。默认 passport(与 PC/微信/飞书分开) -->
            <TextView
                style="@style/FieldLabel"
                android:text="会话名" />

            <EditText
                android:id="@+id/inputSessionName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="默认 passport;agent:main:&lt;名字&gt;"
                android:inputType="text"
                android:autofillHints="none"
                android:textColor="#FFFFFF"
                android:textColorHint="#9E9E9E"
                android:background="@drawable/bg_input"
                android:padding="10dp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/checkUseTls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="使用 HTTPS/WSS"
                android:textColor="#DDDDDD" />

            <!-- 仅调试:OpenClaw 的 wss 自签证书开关(默认关闭,只作用于本通道) -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/checkOpenclawAllowInsecure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="允许自签证书(仅调试,默认关闭,信任所有证书有中间人风险)"
                android:textColor="#DDDDDD" />
        </LinearLayout>

        <!-- Hermes:OpenAI 兼容 HTTP API server,Bearer key -->
        <LinearLayout
            android:id="@+id/groupHermes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hermes(OpenAI 兼容 HTTP)"
                android:textStyle="bold"
                android:textColor="#4FC3F7"
                android:layout_marginTop="8dp" />

            <TextView
                style="@style/FieldLabel"
                android:text="域名" />

            <EditText
                android:id="@+id/inputHermesHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="域名、内网名或 Tailscale 名"
                android:inputType="textUri"
                android:autofillHints="url"
                android:textColor="#FFFFFF"
                android:textColorHint="#9E9E9E"
                android:background="@drawable/bg_input"
                android:padding="10dp" />

            <TextView
                style="@style/FieldLabel"
                android:text="端口" />

            <EditText
                android:id="@+id/inputHermesPort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="默认 8642"
                android:inputType="number"
                android:autofillHints="none"
                android:textColor="#FFFFFF"
                android:textColorHint="#9E9E9E"
                android:background="@drawable/bg_input"
                android:padding="10dp" />

            <TextView
                style="@style/FieldLabel"
                android:text="API Base Path" />

            <EditText
                android:id="@+id/inputHermesBasePath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="反代场景,如 /hermes;默认空"
                android:inputType="textUri"
                android:autofillHints="none"
                android:textColor="#FFFFFF"
                android:textColorHint="#9E9E9E"
                android:background="@drawable/bg_input"
                android:padding="10dp" />

            <TextView
                style="@style/FieldLabel"
                android:text="Token(API_SERVER_KEY)" />

            <EditText
                android:id="@+id/inputHermesToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Bearer,只存本机"
                android:inputType="textVisiblePassword"
                android:autofillHints="none"
                android:textColor="#FFFFFF"
                android:textColorHint="#9E9E9E"
                android:background="@drawable/bg_input"
                android:padding="10dp" />

            <TextView
                style="@style/FieldLabel"
                android:text="模型名" />

            <EditText
                android:id="@+id/inputHermesModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="默认 hermes-agent,仅展示用途"
                android:inputType="text"
                android:autofillHints="none"
                android:textColor="#FFFFFF"
                android:textColorHint="#9E9E9E"
                android:background="@drawable/bg_input"
                android:padding="10dp" />

            <TextView
                style="@style/FieldLabel"
                android:text="会话名(conversation)" />

            <EditText
                android:id="@+id/inputHermesConversation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="留空 = 用设备名/deviceId"
                android:inputType="text"
                android:autofillHints="none"
                android:textColor="#FFFFFF"
                android:textColorHint="#9E9E9E"
                android:background="@drawable/bg_input"
                android:padding="10dp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/checkHermesUseTls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="使用 HTTPS"
                android:textColor="#DDDDDD" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/checkHermesAllowInsecure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="允许自签证书(仅调试,默认关闭)"
                android:textColor="#DDDDDD" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/checkHermesServerSideConversation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="服务端会话(conversation 名,服务端存历史)"
                android:textColor="#DDDDDD" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/checkHermesStream"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="流式回复(SSE)"
                android:textColor="#DDDDDD" />
        </LinearLayout>

        <!-- Echo:本地回环不需要任何字段 -->

        <!-- 自定义 OpenAI 兼容:POST {basePath}/chat/completions,Bearer key,每次带历史 -->
        <LinearLayout
            android:id="@+id/groupOpenai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="自定义 OpenAI 兼容(HTTP,每次请求带历史)"
                android:textStyle="bold"
                android:textColor="#4FC3F7"
                android:layout_marginTop="8dp" />

            <TextView
                style="@style/FieldLabel"
                android:text="域名" />

            <EditText
                android:id="@+id/inputOpenaiHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="域名、内网名或 Tailscale 名"
                android:inputType="textUri"
                android:autofillHints="url"
                android:textColor="#FFFFFF"
                android:textColorHint="#9E9E9E"
                android:background="@drawable/bg_input"
                android:padding="10dp" />

            <TextView
                style="@style/FieldLabel"
                android:text="端口" />

            <EditText
                android:id="@+id/inputOpenaiPort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="默认 8080"
                android:inputType="number"
                android:autofillHints="none"
                android:textColor="#FFFFFF"
                android:textColorHint="#9E9E9E"
                android:background="@drawable/bg_input"
                android:padding="10dp" />

            <TextView
                style="@style/FieldLabel"
                android:text="请求路径" />

            <EditText
                android:id="@+id/inputOpenaiBasePath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="默认 /v1/chat/completions；也可只填 /v1，会自动补 /chat/completions"
                android:inputType="textUri"
                android:autofillHints="none"
                android:textColor="#FFFFFF"
                android:textColorHint="#9E9E9E"
                android:background="@drawable/bg_input"
                android:padding="10dp" />

            <TextView
                style="@style/FieldLabel"
                android:text="API Key" />

            <EditText
                android:id="@+id/inputOpenaiApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Bearer,明文,只存本机;本地服务可留空"
                android:inputType="textVisiblePassword"
                android:autofillHints="none"
                android:textColor="#FFFFFF"
                android:textColorHint="#9E9E9E"
                android:background="@drawable/bg_input"
                android:padding="10dp" />

            <TextView
                style="@style/FieldLabel"
                android:text="模型名" />

            <EditText
                android:id="@+id/inputOpenaiModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="必填,如 gpt-4o-mini"
                android:inputType="text"
                android:autofillHints="none"
                android:textColor="#FFFFFF"
                android:textColorHint="#9E9E9E"
                android:background="@drawable/bg_input"
                android:padding="10dp" />

            <TextView
                style="@style/FieldLabel"
                android:text="系统提示词" />

            <EditText
                android:id="@+id/inputOpenaiSystemPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="system,可留空"
                android:inputType="textMultiLine"
                android:autofillHints="none"
                android:textColor="#FFFFFF"
                android:textColorHint="#9E9E9E"
                android:background="@drawable/bg_input"
                android:padding="10dp" />

            <TextView
                style="@style/FieldLabel"
                android:text="历史条数上限" />

            <EditText
                android:id="@+id/inputOpenaiMaxHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="默认 20 条"
                android:inputType="number"
                android:autofillHints="none"
                android:textColor="#FFFFFF"
                android:textColorHint="#9E9E9E"
                android:background="@drawable/bg_input"
                android:padding="10dp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/checkOpenaiUseTls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="使用 HTTPS"
                android:textColor="#DDDDDD" />

            <!-- 仅调试:自定义 OpenAI 兼容通道的自签证书开关(默认关闭,只作用于本通道) -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/checkOpenaiAllowInsecure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="允许自签证书(仅调试,默认关闭,信任所有证书有中间人风险)"
                android:textColor="#DDDDDD" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/checkOpenaiStream"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="流式回复(SSE)"
                android:textColor="#DDDDDD" />
        </LinearLayout>

        <!-- 语音附加提示:只在【语音输入】时自动追加到发给网关的文本末尾(文字输入不追加)。
             与网关类型无关,所有通道共用;清空即关闭。校验通过才落盘,与其它字段一致。 -->
        <TextView
            android:id="@+id/titleVoicePrompt"
            style="@style/FieldLabel"
            android:layout_marginTop="12dp"
            android:text="语音附加提示（仅语音输入；改完即时生效）" />

        <EditText
            android:id="@+id/inputVoicePromptSuffix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="默认：请用不超过 200 字回复，不要使用 emoji 表情，也不要使用 Markdown 表格。"
            android:inputType="textMultiLine"
            android:autofillHints="none"
            android:textColor="#FFFFFF"
            android:textColorHint="#9E9E9E"
            android:background="@drawable/bg_input"
            android:padding="10dp" />

        <!-- App 调试展示开关:默认开。开启时对话列表展示完整回传流(状态/步骤/工具输出… 弱化小字),一条不丢;
             关掉后 App 也只显示 body(设备/TTS 用的正确正文),适合正式演示。
             纯 App 展示开关,与网关连接无关,因此【切换即落盘】,不走「保存网关设置」的校验-落盘闸门。 -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/checkShowRawStream"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="App 显示完整回传流（调试）"
            android:textColor="#DDDDDD" />

        <!-- 开机自启:App 侧能从 BOOT_COMPLETED 拉起前台服务,但小米/HyperOS 等还需用户在
             系统里把本应用的「自启动」打开,否则开机广播不会送到 App。 -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/checkBootAutoStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="开机自动启动（默认开）"
            android:textColor="#DDDDDD" />

        <TextView
            android:id="@+id/hintBootAutostart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="小米/HyperOS 还需在 系统设置 → 应用管理 → 本应用 → 自启动 里打开；电池策略建议设为「无限制」。"
            android:textColor="#9E9E9E"
            android:textSize="12sp" />

        <!-- 后台运行许可：系统（尤其 MIUI/HyperOS）可能**静默拒绝** startForeground
             （App 收不到异常，只写一条系统日志），服务降级成普通后台服务后闲置 60s 会被停掉。
             这里把状态摆出来 + 一键去系统设置，免得用户以为"服务在跑"。 -->
        <TextView
            android:id="@+id/textForegroundWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#FFB74D"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 版本更新:点一下立刻检查（读 App 仓的 versions.json，三级回退；每天也会自动查一次）。 -->
        <Button
            android:id="@+id/btnCheckUpdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="检查更新"
            android:textColor="@color/accent"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="12dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp" />

        <TextView
            android:id="@+id/updateStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/ink_dim"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnFixBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="打开系统应用设置（开自启动 / 后台无限制）"
            android:visibility="gone" 
            android:textColor="@color/accent"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="12dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp" />

        <!-- 设备朗读(下行 TTS):网关回复上屏之后**再念一遍**。
             设备优先(需设备在 hello 里报 caps:["tts_opus"],固件只在 Opus 解码器就绪时报);
             设备播不了(老固件/未连接)才退回手机自己念;关闭时两边都不出声。
             默认【关】—— 打开前请确认这台手机的 TTS 引擎可用(没装引擎时会显示可读原因并跳过,不会报错)。 -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/checkTtsEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="设备朗读回复（TTS，默认开）"
            android:textColor="#DDDDDD" />

        <TextView
            android:id="@+id/ttsHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="打开后回复会被念出来：优先由设备播报（手机合成 → Opus → BLE 下发），设备不支持时改由手机朗读。播报时设备会暂停拾音，按一下 OK 即可打断。"
            android:textColor="#9E9E9E"
            android:textSize="12sp" />

        <!-- 保存即校验:先按当前输入框的草稿值探活(OpenClaw=WS 鉴权 / Hermes=/health),
             校验通过才落盘;失败不写任何字段并在对话框里显示原因。
             原来的「测试连接」按钮已删除(与保存重复,且保存不再预写草稿)。
             语音桥服务常驻(主界面 onStart 自动拉起),因此不再提供启动/停止按钮。 -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="保存网关设置" 
            android:textColor="@color/ink"
            android:textStyle="bold"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            app:backgroundTint="@color/primary"
            app:cornerRadius="12dp" />

        <TextView
            android:id="@+id/titleXiaozhi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="小智识别(云端流式中文)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/xzStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#4FC3F7"
            android:padding="4dp" />

        <Button
            android:id="@+id/btnActivateXz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="激活小智设备(首次需在 xiaozhi.me 绑定)" 
            android:textColor="@color/accent"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="12dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp" />

        <TextView
            android:id="@+id/xzActiveStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#9E9E9E"
            android:padding="8dp"
            android:background="@drawable/bg_input" />

        <TextView
            android:id="@+id/titleLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="日志"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="(空)"
            android:textSize="12sp"
            android:typeface="monospace"
            android:textColor="#9E9E9E" />

        <!-- 设备管理:整块搬进设置页(原来的「设备」Tab 已去掉)。
             内容用静态子 Fragment 承载 —— 父容器 GONE 时子视图一并隐藏,
             因此这里只需要在 showSection 里拨 groupDevice 一个可见性。 -->
        <LinearLayout
            android:id="@+id/groupDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/titleDevice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="设备管理"
                android:textColor="@color/accent"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/deviceSectionHost"
                android:name="com.shinku.aipassport.openclaw.ui.DevicesFragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
