<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Android 11+ 包可见性：不声明就在系统眼里“看不到”目标包，绑定会被 AppsFilter 直接拦掉。
      真机实测(小米 HyperOS / Android 16)：没有这段时 TextToSpeech 初始化恒为 status=-1，
      系统日志里是
        I/AppsFilter: interaction: com.shinku.aipassport.openclaw -> com.xiaomi.mibrain.speech BLOCKED
      —— 引擎明明装着（tts_default_synth 指向它、系统设置里能试听），第三方 App 却连不上。
      加上 TTS_SERVICE 查询后即可正常枚举音色并合成。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- BLE 扫描/连接(Android 12+ 更细粒度权限) -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- 旧版本 BLE 权限 -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- 扫描需位置(Android 11 及更早) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <!-- WiFi/网络(连自建网关) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 麦克风(系统 SpeechRecognizer 兜底输入) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 前台 Service(保持 BLE 连接与流水线) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 息屏保活:CPU 休眠会停掉小智长连接的 20s ping、Wi-Fi 省电会断掉空闲 TCP -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 开机自启：接收 BOOT_COMPLETED 后拉起前台服务 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.VoiceBridge"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true">

        <!-- launchMode=singleTop:再次启动（含诊断用的 am start 带 extra 那种）会打到**已在栈顶的同一个实例**，
             走 onNewIntent 而不是新建一个 Activity。主界面是常驻的仪表板，重复启动没有理由重建它。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.VoiceBridgeService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- 看门狗：定时确认语音桥还在跑，被系统停掉后拉回来（见 ServiceGuard / ServiceWatchdogReceiver）。
             只由 App 自己的闹钟 PendingIntent（显式 Intent）触发，因此 exported=false。 -->
        <receiver
            android:name=".service.ServiceWatchdogReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- 开机自启：收到开机广播后按用户设置拉起前台服务。
             exported 必须为 true 才能收到系统广播；小米/HyperOS 还需用户在系统里开本应用的「自启动」。
             同时收应用更新广播（MY_PACKAGE_REPLACED）：更新会杀进程、可能清掉闹钟，
             要按用户更新前的意愿把桥恢复起来（这也是 Android 12+ 允许启动前台服务的官方豁免之一）。 -->
        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
